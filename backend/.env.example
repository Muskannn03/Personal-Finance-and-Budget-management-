# PBFM Backend Environment Variables Template
# Copy this file to .env and adjust variables as per your local setup

# Application configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=PFBM
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Security Configuration
# JWT secret must be a base64 encoded string of at least 256 bits (32 bytes)
JWT_SECRET=dGhpcy1pcy1hLXZlcnktc2VjdXJlLWFuZC1sb25nLXNlY3JldC1rZXktZm9yLXBjZm0tYXBwbGljYXRpb24tMjAyNg==
# JWT Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000
